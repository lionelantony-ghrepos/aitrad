# Server-only seed (PBI-005). Do not put these in NEXT_PUBLIC_*.
# Copy to a gitignored `.env` — never commit real keys.
# Ports and re-seed steps: insforge/local.config.json and insforge/README.md.
# Codespaces Path A: docs/codespaces-path-a.md
#
# Hosted: https://your-app.region.insforge.app
# Local Docker (`npx -y @insforge/cli local start`): http://localhost:7130
#   (if the CLI shifted ports, use the printed app URL)
# API key: `npx -y @insforge/cli secrets get API_KEY` (or local status --show-keys)
#
# GitHub Codespaces: do not store keys in this file or as NEXT_PUBLIC_* / INSFORGE_*
# Codespaces secrets. Local start mints keys per codespace. Optional Codespaces
# secret: OPENROUTER_API_KEY (live copilot/RAG only). Paper smoke uses hash mode.
INSFORGE_URL=http://localhost:7130
INSFORGE_API_KEY=
# Embeddings (PBI-023). Server-only; never NEXT_PUBLIC_*.
# Local re-seed without a Model Gateway:
MERIDIAN_EMBEDDING_MODE=hash
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_EMBEDDINGS_URL=
