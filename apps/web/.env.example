# Hosted InsForge Cloud:
# NEXT_PUBLIC_INSFORGE_URL=https://your-app.region.insforge.app
# Local Docker (`npx -y @insforge/cli local start` seeds repo-root `.env.local`).
# Copy those two values here if the Next app does not load the repo-root file.
# `next.config` overlays these keys from `.env.local` so ambient/Cloud-injected
# NEXT_PUBLIC_INSFORGE_* cannot point the app at a different project.
# Defaults: insforge/local.config.json (app port 7130).
#
# Codespaces Path A (docs/codespaces-path-a.md): keep these on localhost:7130 /
# 127.0.0.1:3000 when VS Code/Cursor forwards those ports. If you only use the
# github.dev forwarded origin, point URL + APP_URL at the private :7130 / :3000
# HTTPS forwards and restart Next. Never commit real keys; do not set these as
# Codespaces secrets (local start writes them per codespace).
NEXT_PUBLIC_INSFORGE_URL=http://localhost:7130
NEXT_PUBLIC_INSFORGE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Playwright / CI only — never enable against a live project
E2E_AUTH_STUB=
