{
  "name": "meridian",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:kb-check": "node scripts/check-kb.mjs",
    "docs:generate": "node scripts/generate-kb-reference.mjs",
    "docs:kb-test": "node --test scripts/check-kb.test.mjs",
    "seed": "node --import tsx --env-file=.env scripts/seed.ts",
    "seed:rules": "node --import tsx --env-file=.env scripts/seed-rules.ts",
    "functions:bundle:rules-service": "node scripts/bundle-rules-service.mjs",
    "functions:bundle:order-service": "node scripts/bundle-order-service.mjs",
    "functions:bundle:matching-runner": "node scripts/bundle-matching-runner.mjs",
    "functions:bundle:market-tick": "node scripts/bundle-market-tick.mjs",
    "functions:bundle:news-ticker": "node scripts/bundle-news-ticker.mjs",
    "functions:bundle:analytics-service": "node scripts/bundle-analytics-service.mjs",
    "functions:bundle:screener": "node scripts/bundle-screener.mjs",
    "functions:bundle:alert-runner": "node scripts/bundle-alert-runner.mjs",
    "functions:bundle:embed-worker": "node scripts/bundle-embed-worker.mjs",
    "functions:bundle:search-news": "node scripts/bundle-search-news.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@insforge/sdk": "^1.5.2",
    "@meridian/mock-data": "workspace:*",
    "@meridian/rag": "workspace:*",
    "@meridian/schemas": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^20",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
